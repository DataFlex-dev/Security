Use Batchdd.pkg
Use seq_chnl.pkg
Use MSSqldrv.pkg

Define C_PWNEDPASSWORDSIMPORT_BATCH_SIZE for 1000

Declare_Datafile PwnedPasswords

Object oPwnedPasswordsImport_BP is a BusinessProcess

    Object oSql is a cSQLHandleManager
    End_Object

    // The name of the file to import
    Property String psFilename

    Set Allow_Cancel_State to True

    { Visibility=Private }
    Procedure SaveRecords Handle hoDbc String[] ByRef asRecords
        Handle hoStmt
        String sQry

        If (SizeOfArray(asRecords) = 0) Procedure_Return

        Move (SFormat("INSERT INTO PwnedPasswords (PasscodeSha1, Frequency) VALUES (%1)", ;
                StrJoinFromArray(asRecords, '),('))) to sQry

        // execute query
        Get SQLOpen of hoDbc to hoStmt
        Send SQLExecDirect of hoStmt sQry
        Send SQLClose of hoStmt

        Move (ResizeArray(asRecords, 0)) to asRecords
    End_Procedure

    Procedure OnProcess
        Boolean bCancel
        Handle  hoDbc
        Integer iChannel
        Integer iLines
        Integer iImported
        String  sFilename
        String  sInput
        String[] asRecords

        Get Seq_New_Channel to iChannel
        If (iChannel = DF_SEQ_CHANNEL_NOT_AVAILABLE) Begin
            Error DFERR_PROGRAM "No Channel Available for Process"
            Procedure_Return
        End

        Open PwnedPasswords
        Get SQLFileConnect of oSql PwnedPasswords.File_Number to hoDbc

        Get psFileName to sFilename
        Direct_Input channel iChannel (ToANSI(sFilename))
        While (not(SeqEof))
            Readln channel iChannel sInput
            Move ("0x" + Replaces(':', Rtrim(sInput), ",")) to asRecords[SizeOfArray(asRecords)]

            Increment iLines

            If (Mod(iLines, C_PWNEDPASSWORDSIMPORT_BATCH_SIZE) = 0) Begin
                Get Cancel_Check to bCancel
                If bCancel Begin
                    Move True to SeqEof
                End
                Else Begin
                    Send SaveRecords hoDbc (&asRecords)
                    Add C_PWNEDPASSWORDSIMPORT_BATCH_SIZE to iImported
                    Send Update_Status (SFormat("Pwned passwords imported: %1", iImported))
                End
            End
        Loop
        Close_Input channel iChannel
        Send Seq_Release_Channel iChannel

        If not bCancel Begin
            Send SaveRecords hoDbc (&asRecords)
            Move iLines to iImported
        End

        Send SQLDisconnect of hoDbc
    End_Procedure

End_Object
