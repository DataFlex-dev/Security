Use cConnection.pkg

Object oApplication is a cApplication
    Set pbPreserveEnvironment to False
    Set peHelpType to htNoHelp

    Object oConnection is a cConnection
        Use LoginEncryption.pkg
        Use DatabaseLoginDialog.dg
    End_Object
End_Object

Use File_dlg.pkg
Use PwnedPasswordsImport_BP.bp

Function ArgumentFromCommandLine Integer iIndex Returns String
    Handle  hoCmdLine
    Integer iArgCount
    String  sArg

    Get phoCommandLine of ghoApplication to hoCmdLine
    Get CountOfArgs of hoCmdLine to iArgCount
    If (iArgCount >= iIndex) Get Argument of (phoCommandLine(ghoApplication)) iIndex to sArg

    Function_Return sArg
End_Function

Object oOpenPwnedDialog is an OpenDialog
    Set Filter_String to 'Text files|*.txt'
    Set Filter_Index to 2
    Set Dialog_Caption to "Select (a) file(s) from HaveIBeenPwned to import"
    Set HideReadOnly_State to True
    Set Initial_Folder to "%USERPROFILE%\Documents"
    Set MultiSelect_State to True
End_Object

Procedure Main
    Boolean  bFileExists
    Boolean  bOpen
    Integer  iErrors
    Integer  iFile iLastFile
    String   sFilename
    String[] asFiles

    Get ArgumentFromCommandLine 1 to sFilename
    If (sFilename <> '') File_Exist (ToANSI(sFilename)) bFileExists
    If bFileExists Begin
        Move sFilename to asFiles[0]
    End
    Begin
        // ask user with file open dialog
        Get Show_Dialog of oOpenPwnedDialog to bOpen
        If bOpen Begin
            Get Selected_Files of oOpenPwnedDialog to asFiles
        End
        Else Increment iErrors
    End

    If (iErrors = 0) Begin
        Move (SizeOfArray(asFiles)-1) to iLastFile
        For iFile from 0 to iLastFile
            File_Exist (ToANSI(asFiles[iFile])) bFileExists
            If not bFileExists begin
                Increment iErrors
            End
            Else Begin
                Set psFileName of oPwnedPasswordsImport_BP to asFiles[iFile]
                Send DoProcess of oPwnedPasswordsImport_BP
            End
        Loop
    End

    If (iErrors > 0) Begin
        Error DFERR_OPERATOR "No file selected, or one or more files could not be opened."
        Procedure_Return
    End
End_Procedure

Send Main
